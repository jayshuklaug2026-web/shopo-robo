# Shopo Robo — Production Environment Variables Template
# Copy this file to .env or configure in your cloud hosting provider dashboard.
# NEVER commit .env with real secret keys to source control!

# ==========================================
# 1. CORE APPLICATION & SECURITY
# ==========================================
SHOPO_ENV=production
SHOPO_DEBUG=False
# Generate a secure 64-character hex key with: python -c "import secrets; print(secrets.token_hex(32))"
SHOPO_SECRET_KEY=your_64_character_random_secret_key_here
SHOPO_HOST=0.0.0.0
PORT=5000

# Persistent SQLite database location (mount a persistent volume here)
SHOPO_DB_PATH=/var/data/shopo_robo.db

# Enforce secure cookies over HTTPS
SHOPO_COOKIE_SECURE=True

# ==========================================
# 2. AUTHENTICATION & SMS OTP
# ==========================================
# "mock" for predictable testing (code 123456); "production" for real SMS delivery
SHOPO_OTP_MODE=mock
SHOPO_SMS_PROVIDER=
SHOPO_SMS_API_KEY=
SHOPO_SMS_SENDER_ID=SHOPRO
SHOPO_SMS_TEMPLATE_ID=

# ==========================================
# 3. SUBSCRIPTION BILLING
# ==========================================
# Strictly KEEP FALSE — subscription billing is disabled.
SHOPO_SUBSCRIPTION_ENABLED=False
SHOPO_SUBSCRIPTION_PRICE=150

# ==========================================
# 4. UNIVERSAL AI PROVIDERS
# ==========================================
# Preferred Provider: "auto" | "gemini" | "openai" | "anthropic" | "local"
# "auto" uses Gemini if GEMINI_API_KEY is found, else falls back to local SmartLocalEngine.
SHOPO_AI_PROVIDER=auto

# Google Gemini API Key (Get key from https://aistudio.google.com/)
GEMINI_API_KEY=
SHOPO_GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (optional)
OPENAI_API_KEY=
SHOPO_OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API Key (optional)
ANTHROPIC_API_KEY=
SHOPO_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ==========================================
# 5. WEB SEARCH ENGINE
# ==========================================
# "auto" | "ddgs" | "tavily"
# DuckDuckGo works out-of-the-box with no API key required.
SHOPO_WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SHOPO_SEARCH_MAX_RESULTS=4

# ==========================================
# 6. INDIA MARKET & WEATHER INTELLIGENCE
# ==========================================
DATA_GOV_IN_API_KEY=
SHOPO_ENABLE_LIVE_WEATHER=True
